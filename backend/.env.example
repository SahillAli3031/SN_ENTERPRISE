# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/painting_platform

# JWT — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Allowed browser origin (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# Gallery media uploads (local disk — see README for storage limitations)
# Directory relative to the backend working directory; served at /uploads
UPLOAD_DIR=uploads
# Size limits in bytes: images 10 MB, videos 100 MB
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_VIDEO_BYTES=104857600

